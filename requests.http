### Anlegen: paciente — erwartet 201
POST {{baseUrl}}/pacientes
Content-Type: application/json

{
  "cpf": "00000000001",
  "nome_completo": "Paciente de Exemplo",
  "data_nascimento": "1990-05-20",
  "sexo_biologico": "feminino",
  "telefone": "81900000001",
  "email": "paciente@example.com",
  "logradouro": "Rua Exemplo",
  "numero_endereco": "100",
  "bairro": "Centro",
  "cidade": "Recife",
  "estado": "PE",
  "cep": "50000000",
  "possui_plano_saude": false
}

